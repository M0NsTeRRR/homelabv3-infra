{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customDatasources": {
    "k3s-minor-channels": {
      "defaultRegistryUrlTemplate": "https://update.k3s.io/v1-release/channels",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": data[$match(id, /^v[0-9]+\\.[0-9]+$/)].{\"version\": id}}"
      ]
    }
  },
  "customManagers": [
    {
      "description": ["Process k3s full version (extension file + release asset)"],
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)flatcar/base\\.k3s\\.bu$/"],
      "matchStrings": [
        "k3s-(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+)-x86-64\\.raw"
      ],
      "packageNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": ["Process k3s minor track (systemd-sysupdate transfer file)"],
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)flatcar/base\\.k3s\\.bu$/"],
      "matchStrings": [
        "k3s-(?<currentValue>v[0-9]+\\.[0-9]+)(?:\\.d|\\.conf|\\s)"
      ],
      "depNameTemplate": "k3s-minor",
      "datasourceTemplate": "custom.k3s-minor-channels",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": ["Group k3s full + minor-track updates into a single PR"],
      "matchDepNames": ["k3s-io/k3s", "k3s-minor"],
      "groupName": "k3s"
    },
    {
      "description": ["k3s-minor uses a custom datasource, so it doesn't inherit the repo's github-releases commit message format — set it explicitly to match"],
      "matchDepNames": ["k3s-minor"],
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )"
    }
  ]
}
