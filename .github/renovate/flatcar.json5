{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customDatasources": {
    "flatcar-releases": {
      "defaultRegistryUrlTemplate": "https://{{packageName}}.release.flatcar-linux.net/amd64-usr/current/version.txt",
      "format": "plain",
      "transformTemplates": [
        "($version := $match(releases[$match(version, /^FLATCAR_VERSION=/)].version, /FLATCAR_VERSION=(\\S+)/).groups[0]; {\"releases\": [{\"version\": $version}], \"changelogUrl\": \"https://www.flatcar.org/releases#release-\" & $version})"
      ]
    }
  },
  "customManagers": [
    {
      "description": ["Process Flatcar version"],
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.justfiles/flatcar\\.just$/"],
      "matchStrings": [
        "flatcar_version := '(?<currentValue>[^']+)'(?<comment>[^\\n]*)\\nflatcar_channel := '(?<packageName>[^']+)'"
      ],
      "autoReplaceStringTemplate": "flatcar_version := '{{{newValue}}}'{{{comment}}}\nflatcar_channel := '{{{packageName}}}'",
      "depNameTemplate": "flatcar",
      "datasourceTemplate": "custom.flatcar-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": ["Flatcar: always show the full version, even on major bumps"],
      "matchDatasources": ["custom.flatcar-releases"],
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )"
    }
  ]
}
